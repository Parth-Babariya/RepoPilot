# Copy to .env (same folder) and fill in what your config.yaml needs.

# Required when llm.provider is "gemini" (the default — free tier).
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Required when llm.provider or embeddings.provider is "openai"
OPENAI_API_KEY=

# Required when llm.provider is "anthropic"
ANTHROPIC_API_KEY=

# Required when llm.provider is "groq" (free tier, very fast).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Qdrant Cloud (leave empty to use a local Qdrant on localhost:6333)
QDRANT_URL=
QDRANT_API_KEY=

# Optional: enables the GitHub MCP tools for /ask
GITHUB_TOKEN=

# Optional: overrides semantic_cache.redis_url in config.yaml (docker-compose sets this itself)
REDIS_URL=
